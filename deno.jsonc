{
  "version": "0.4.9#muq2nrcc",
  "description": "Build orchestration, bundling and AI context export utilities for Deno & Web projects.",
  "workspace": [
    "./packages/server",
    "./packages/ui",
    "./packages/utils"
  ],
  // ⚙️ Configurações Rigorosas do Compilador TypeScript (FASE 4)
  "compilerOptions": {
    "lib": [
      "deno.window",
      "esnext"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  // 📦 Gerenciamento de Dependências
  "minimumDependencyAge": 60,
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.20"
  },
  "catalog": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": ["npm:esbuild@0.28.2"],
  // 🛠️ Scripts de Automação
  "tasks": {
    "test": "deno test --no-check --unstable-bundle -P",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno task --cwd packages/utils check && deno task --cwd packages/ui check && deno task --cwd packages/server check && deno check scripts/denobuild.ts scripts/esbuild.ts scripts/export.ts scripts/sanitize-version.ts scripts/tag-version.ts scripts/watch.ts",
    "fmt:check": "deno fmt --check",
    "lint:fix": "deno lint --fix",
    "lint:doc": "deno task --cwd packages/utils lint:doc",
    "tests": "deno task check && deno task lint && deno task fmt:check && deno task test",
    "dev": "deno task --cwd packages/server dev",
    "start": "deno task --cwd packages/server start",
    "export": "deno run --allow-read --allow-write ./scripts/export.ts",
    "esbuild": "deno run -A ./scripts/esbuild.ts",
    "denobuild": "deno run --unstable-bundle -A ./scripts/denobuild.ts",
    "watch": "deno run -A ./scripts/watch.ts",
    "sanitize-version": "deno run -A ./scripts/sanitize-version.ts",
    "tag-version": "deno run -A ./scripts/tag-version.ts",
    "bump": "deno install --frozen=false && deno task build dist noversion && deno task tag-version"
  },
  "nodeModulesDir": "none",
  "vendor": true,
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": ["no-unused-vars"]
    },
    "include": [
      "build.ts",
      "scripts/denobuild.ts",
      "scripts/esbuild.ts",
      "scripts/export.ts",
      "scripts/sanitize-version.ts",
      "scripts/tag-version.ts",
      "scripts/watch.ts",
      "examples/**/*.{ts,tsx}",
      "packages/**/src/**/*.{ts,tsx}",
      "tests/**/*test.ts",
      "packages/**/tests/**/*test.ts"
    ]
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "net": true,
      "env": true,
      "sys": true,
      "run": true,
      "ffi": true,
      "import": true
    },
    "include": [
      "tests/**/*test.ts",
      "packages/**/tests/**/*test.ts"
    ],
    "exclude": [
      "packages/server/build/",
      "build.ts",
      "scripts/esbuild.ts",
      "scripts/export.ts",
      "scripts/sanitize-version.ts",
      "scripts/tag-version.ts",
      "examples/**/*.{ts,tsx}",
      "packages/**/src/**/*.{ts,tsx}"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "trailingCommas": "always",
    "json.trailingCommas": "never",
    "operatorPosition": "maintain",
    "jsx.bracketPosition": "sameLine",
    "jsx.forceNewLinesSurroundingContent": true,
    "jsx.multiLineParens": "always",
    "newLineKind": "lf",
    "include": [
      "build.ts",
      "scripts/esbuild.ts",
      "scripts/export.ts",
      "scripts/sanitize-version.ts",
      "scripts/tag-version.ts",
      "examples/**/*.{ts,tsx}",
      "packages/**/src/**/*.{ts,tsx}",
      "tests/**/*test.ts",
      "packages/**/tests/**/*test.ts"
    ],
    "exclude": [
      "packages/server/build/"
    ]
  },
  "unstable": ["bundle"],
  "exclude": [
    ".qwen/",
    ".vscode/",
    "packages/server/build/",
    "vendor",
    "node_modules",
    "snapshots",
    "docs"
  ]
}
