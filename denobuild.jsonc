{
  "$schema": "./packages/utils/schema/denobuild.json",
  "version": "0.3.6",
  "targets": {
    "ui": {
      "mode": "build",
      "default": true,
      "srcdir": "packages/ui/src",
      "distdir": "packages/server/build/dist",
      "copyFiles": [
        {
          "basedir": "packages/ui/public"
        },
        {
          "basedir": "packages/ui/src",
          "includes": [
            "index.html"
          ]
        }
      ],
      "clean": {
        "includes": [
          "*"
        ]
      },
      "entryPoints": [
        "main.tsx"
      ],
      "platform": "browser",
      "format": "esm",
      "minify": false,
      "sourcemap": "linked",
      "keepNames": true,
      "codeSplitting": false,
      "packages": "bundle",
      "inlineImports": true
    }
  }
}
