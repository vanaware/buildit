{
  "outDir": "packages/server/build/dist",
  "includes": [
    "packages/utils/src/**/*.{ts,tsx}"
  ],
  "excludes": [
    "**/tests/**",
    "**/node_modules/**"
  ],
  "staticFiles": [
    "packages/utils/schema/**/*.json"
  ],
  "reports": {
    "apiSurface": true,
    "coverage": true
  },
  "docsify": {
    "enabled": true,
    "title": "BuildIt Documentation",
    "name": "BuildIt Engine",
    "description": "Orchestration and documentation tools for Deno workspaces.",
    "theme": "vue",
    "search": true,
    "pagination": true,
    "copyCode": true,
    "mermaid": true,
    "darkModeToggle": true
  }
}
