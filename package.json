{
  "name": "buildit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export PATH=\"$HOME/.deno/bin:/root/.deno/bin:/usr/local/bin:$PATH\" && bash ./install-script.sh && deno task build noversion && deno task dev",
    "build": "export PATH=\"$HOME/.deno/bin:/root/.deno/bin:/usr/local/bin:$PATH\" && bash ./install-script.sh && deno task build",
    "start": "export PATH=\"$HOME/.deno/bin:/root/.deno/bin:/usr/local/bin:$PATH\" && bash ./install-script.sh && deno task start",
    "lint": "export PATH=\"$HOME/.deno/bin:/root/.deno/bin:/usr/local/bin:$PATH\" && bash ./install-script.sh && deno task lint",
    "test": "export PATH=\"$HOME/.deno/bin:/root/.deno/bin:/usr/local/bin:$PATH\" && bash ./install-script.sh && deno task tests"
  }
}
